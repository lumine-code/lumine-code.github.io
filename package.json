{
  "name": "lumine-code.github.io",
  "description": "Website and documentation for the Lumine text editor.",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node script/serve.js",
    "docs:api": "node script/generate-api-docs.js",
    "docs:api:check": "node script/generate-api-docs.js --check",
    "test:api-docs": "node --test script/generate-api-docs.test.js script/api-search.test.js",
    "test:docs": "node --test script/docs-navigation.test.js script/docs-rendering.test.js",
    "test:site": "node --test script/site.test.js script/gallery.test.js script/packages.test.js script/package-details.test.js",
    "gallery:generate": "node script/generate-gallery.js",
    "assets:sync": "node script/check-assets.js --write",
    "assets:check": "node script/check-assets.js"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "dompurify": "^3.4.17",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "parse5": "^8.0.1"
  },
  "license": "MIT"
}
