    {
      "title": "Scrollbar overview",
      "services": [
        "scrollmap.layer",
        "scrollmap.widget"
      ]
    },
    {
      "title": "Panels",
      "services": [
        "search.control",
        "search.adapter",
        "navigation.headers",
        "navigation.adapter"
      ]
