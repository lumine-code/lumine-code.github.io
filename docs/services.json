    "autocomplete.watch-editor": {
      "name": "autocomplete.watch-editor",
      "group": "Completion and grammars",
      "summary": "A function that turns autocompletion on for an editor autocomplete would otherwise ignore — one inside a panel, a dock, or any pane item that is not a workspace-center tab.",
      "version": "1.0.0",
      "owner": "autocomplete",
      "src": "https://raw.githubusercontent.com/lumine-code/lumine/master/packages/autocomplete/docs/autocomplete.watch-editor.md",
